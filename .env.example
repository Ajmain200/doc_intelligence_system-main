# Copy this file to .env and fill in your values. Never commit .env.
PROJECT_NAME="AI-Powered Document Intelligence System"
VERSION="1.0.0"

# Relative SQLite paths are resolved against the project root
DATABASE_URL="sqlite:///./doc_intelligence.db"
PDF_PAGE_CHUNK_SIZE=15
MAX_FILE_SIZE_MB=100

# 'gemini', 'openai', or 'heuristic_fallback' (offline, rule-based)
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Full path to tesseract.exe on Windows if it is not on PATH, e.g.
# TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"
TESSERACT_CMD="tesseract"

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
